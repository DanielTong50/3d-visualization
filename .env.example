# Copy this file to a new file named ".env" in this same folder, then fill in the values.
# ".env" is listed in .gitignore, so your keys are never committed to git.
# Never paste keys into a chat.

# Meta Model API key (starts with "LLM_"). Used for Muse Spark: reading manuals and checking
# camera frames against a plan. Get one at https://dev.meta.ai -> API keys -> Create API key.
MODEL_API_KEY=

# Modal (cloud hosting for the API) needs no key here: run `uv run modal token new` once in
# the engine folder; it saves your login in ~/.modal.toml.

# Optional: if set, the deployed API asks for this code before any model call (reading a
# manual, checking frames, decoding a video), since those spend credits. Share it only with
# testers.
DARIUS_ACCESS_CODE=
