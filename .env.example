# Copy this file to a new file named ".env" in this same folder, then fill in the values.
# ".env" is listed in .gitignore, so your keys are never committed to git.
# Never paste keys into a chat.

# Meta Model API key (starts with "LLM_"). Used for Muse Spark, SAM 3.1 and Muse Image.
# Get one at https://dev.meta.ai -> API keys -> Create API key.
MODEL_API_KEY=

# Hugging Face access token (type "Read"). Used by the reconstruction stage to download the
# VGGT-1B-Commercial weights. First request access (free; approval can take a while) on
# https://huggingface.co/facebook/VGGT-1B-Commercial, then create the token at
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Modal (cloud GPUs) needs no key here: run `uv run modal token new` once in the
# pipeline folder; it saves your login in ~/.modal.toml.

# Optional: if set, the deployed API asks for this code before processing a video
# or running a "what if" scenario (both spend credits). Share it only with testers.
SCAN2SIM_ACCESS_CODE=
