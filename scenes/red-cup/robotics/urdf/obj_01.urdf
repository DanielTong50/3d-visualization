<?xml version="1.0"?>
<robot name="obj_01">
  <!-- plastic cup: plastic, 34 g. Written by Darius 0.2.0. Link frame: +z up, origin at the capture-time bounding-box center; place it at the pose in world.json -->
  <mujoco>
    <compiler meshdir="../meshes/" discardvisual="true" balanceinertia="true" fusestatic="false" />
  </mujoco>
  <link name="obj_01">
    <inertial>
      <origin xyz="0.00366 0.00148 -0.00233" rpy="0 0 0" />
      <mass value="0.0338" />
      <inertia ixx="8.50326e-05" ixy="8.63072e-07" ixz="7.22836e-06" iyy="8.18419e-05" iyz="-1.14719e-05" izz="0.000106454" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="../meshes/obj_01_visual.obj" />
      </geometry>
      <material name="obj_01_color">
        <color rgba="0.816 0.165 0.141 1" />
      </material>
    </visual>
    <collision name="obj_01_part0">
      <geometry>
        <mesh filename="../meshes/obj_01_part0.obj" />
      </geometry>
    </collision>
    <collision name="obj_01_part1">
      <geometry>
        <mesh filename="../meshes/obj_01_part1.obj" />
      </geometry>
    </collision>
    <collision name="obj_01_part2">
      <geometry>
        <mesh filename="../meshes/obj_01_part2.obj" />
      </geometry>
    </collision>
    <collision name="obj_01_part3">
      <geometry>
        <mesh filename="../meshes/obj_01_part3.obj" />
      </geometry>
    </collision>
    <collision name="obj_01_part4">
      <geometry>
        <mesh filename="../meshes/obj_01_part4.obj" />
      </geometry>
    </collision>
    <collision name="obj_01_part5">
      <geometry>
        <mesh filename="../meshes/obj_01_part5.obj" />
      </geometry>
    </collision>
    <collision name="obj_01_part6">
      <geometry>
        <mesh filename="../meshes/obj_01_part6.obj" />
      </geometry>
    </collision>
    <collision name="obj_01_part7">
      <geometry>
        <mesh filename="../meshes/obj_01_part7.obj" />
      </geometry>
    </collision>
    <contact>
      <lateral_friction value="0.4" />
      <restitution value="0.2" />
    </contact>
  </link>
</robot>
