                point3f[] points = [(0.04207, -0.03959, 0.00883), (-0.09068, 0.01842, -0.0377), (0.02053, 0.05224, -0.0377), (-0.0344, -0.05222, -0.0377), (-0.04653, -0.0039, 0.02558), (0.09068, 0.01378, -0.0377), (0.0245, 0.02284, 0.02426), (0.07089, -0.04143, -0.0377), (-0.0524, 0.04373, -0.02658), (-0.0467, -0.04488, 0.00508), (0.06307, 0.04317, -0.02703), (-0.00329, 0.00022, 0.03679), (0.08751, 0.01034, -0.00065), (0.07142, -0.02358, -0.00256), (0.03539, 0.03627, 0.00142), (0.05524, -0.04857, -0.01465), (0.03948, 0.00148, 0.0343), (-0.07722, 0.03687, -0.02568), (0.04545, -0.04977, -0.0377), (0.08075, 0.02974, -0.01464), (0.04044, 0.0506, -0.02936), (0.07245, -0.03714, -0.01667), (-0.05063, -0.02759, 0.01329), (0.04299, 0.02243, 0.0187), (-0.03312, -0.05224, -0.00582), (0.07485, 0.03579, -0.0377), (0.05073, -0.02535, 0.01404), (0.02652, 0.01147, 0.03591), (-0.06739, 0.04206, -0.0377), (0.01197, 0.00436, 0.0377), (0.05498, -0.04198, -0.00035), (0.09018, 0.02012, -0.0116)]
                uniform token subdivisionScheme = "none"
                color3f[] primvars:displayColor = [(0.071, 0.122, 0.075)]
                rel material:binding:physics = </World/PhysicsMaterials/obj_01>
            }
        }
    }

