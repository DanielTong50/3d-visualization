<?xml version="1.0"?>
<robot name="obj_01">
  <!-- book: paper, 312 g. Written by Darius 0.2.0. Link frame: +z up, origin at the capture-time bounding-box center; place it at the pose in world.json -->
  <mujoco>
    <compiler meshdir="../meshes/" discardvisual="true" balanceinertia="true" fusestatic="false" />
  </mujoco>
  <link name="obj_01">
    <inertial>
      <origin xyz="-0.00051 -0.00266 -0.00443" rpy="0 0 0" />
      <mass value="0.3118" />
      <inertia ixx="0.000500391" ixy="-4.70297e-05" ixz="5.79369e-06" iyy="0.000469227" iyz="1.79467e-05" izz="0.000940792" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="../meshes/obj_01_visual.obj" />
      </geometry>
      <material name="obj_01_color">
        <color rgba="0.878 0.333 0.341 1" />
      </material>
    </visual>
    <collision name="obj_01">
      <geometry>
        <mesh filename="../meshes/obj_01.obj" />
      </geometry>
    </collision>
    <contact>
      <lateral_friction value="0.6" />
      <restitution value="0.05" />
    </contact>
  </link>
</robot>
