<?xml version="1.0"?>
<robot name="obj_01">
  <!-- white mug: ceramic, 263 g. Written by Darius 0.2.0. Link frame: +z up, origin at the capture-time bounding-box center; place it at the pose in world.json -->
  <mujoco>
    <compiler meshdir="../meshes/" discardvisual="true" balanceinertia="true" fusestatic="false" />
  </mujoco>
  <link name="obj_01">
    <inertial>
      <origin xyz="0.005 0.00281 -0.00111" rpy="0 0 0" />
      <mass value="0.2634" />
      <inertia ixx="0.000392634" ixy="6.91814e-05" ixz="-1.75888e-05" iyy="0.000390793" iyz="1.59607e-05" izz="0.000425159" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="../meshes/obj_01_visual.obj" />
      </geometry>
      <material name="obj_01_color">
        <color rgba="0.494 0.565 0.667 1" />
      </material>
    </visual>
    <collision name="obj_01">
      <geometry>
        <mesh filename="../meshes/obj_01.obj" />
      </geometry>
    </collision>
    <contact>
      <lateral_friction value="0.5" />
      <restitution value="0.1" />
    </contact>
  </link>
</robot>
