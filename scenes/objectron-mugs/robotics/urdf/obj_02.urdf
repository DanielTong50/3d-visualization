<?xml version="1.0"?>
<robot name="obj_02">
  <!-- purple mug: ceramic, 232 g. Written by Darius 0.2.0. Link frame: +z up, origin at the capture-time bounding-box center; place it at the pose in world.json -->
  <mujoco>
    <compiler meshdir="../meshes/" discardvisual="true" balanceinertia="true" fusestatic="false" />
  </mujoco>
  <link name="obj_02">
    <inertial>
      <origin xyz="-0.00621 0.00475 0.00818" rpy="0 0 0" />
      <mass value="0.2316" />
      <inertia ixx="0.00039299" ixy="-1.59859e-05" ixz="-4.16999e-05" iyy="0.000322845" iyz="-2.47762e-05" izz="0.000455754" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="../meshes/obj_02_visual.obj" />
      </geometry>
      <material name="obj_02_color">
        <color rgba="0.314 0.196 0.329 1" />
      </material>
    </visual>
    <collision name="obj_02_part0">
      <geometry>
        <mesh filename="../meshes/obj_02_part0.obj" />
      </geometry>
    </collision>
    <collision name="obj_02_part1">
