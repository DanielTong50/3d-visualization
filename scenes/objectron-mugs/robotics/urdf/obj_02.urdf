      </geometry>
    </collision>
    <collision name="obj_02_part4">
      <geometry>
        <mesh filename="../meshes/obj_02_part4.obj" />
      </geometry>
    </collision>
    <collision name="obj_02_part5">
      <geometry>
        <mesh filename="../meshes/obj_02_part5.obj" />
      </geometry>
    </collision>
    <collision name="obj_02_part6">
      <geometry>
        <mesh filename="../meshes/obj_02_part6.obj" />
      </geometry>
    </collision>
    <collision name="obj_02_part7">
      <geometry>
        <mesh filename="../meshes/obj_02_part7.obj" />
      </geometry>
    </collision>
    <contact>
