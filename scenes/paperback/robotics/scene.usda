                point3f[] points = [(-0.04387, -0.0538, -0.01582), (0.04309, 0.0541, 0.01575), (-0.04331, 0.03835, -0.01582), (0.04552, -0.04432, 0.00184), (0.0018, 0.05397, 0.00534), (-0.04359, -0.01962, -0.00584), (0.042, -0.01317, 0.01114), (0.03754, 0.05454, -0.01582), (-0.04154, 0.0129, -0.00357), (-0.0281, 0.05413, -0.00355), (0.03874, -0.05483, -0.01582), (-0.04325, -0.03846, -0.0058), (0.02965, -0.05138, 0.00237), (-0.03884, 0.05407, -0.01582), (-0.02895, -0.05422, -0.01089), (-0.04157, 0.02949, -0.00334), (0.04206, -0.03157, 0.00945), (0.01445, 0.05376, 0.00877), (-0.01725, 0.0537, 0.00011), (-0.03864, -0.05123, -0.00672), (-0.04552, -0.03765, -0.01582), (0.0439, 0.04391, 0.01582), (-0.04251, 0.04823, -0.00836), (0.04532, -0.04718, -0.01582), (-0.03982, 0.03907, -0.00359), (-0.04118, -0.02867, -0.00491), (-0.02984, 0.05469, -0.01582), (0.03941, 0.05483, 0.00798), (0.04073, -0.0497, 0.00622), (-0.03655, 0.05412, -0.00782), (0.04357, 0.04896, -0.01582), (-0.04271, 0.0049, -0.00457)]
                uniform token subdivisionScheme = "none"
                color3f[] primvars:displayColor = [(0.204, 0.133, 0.243)]
                rel material:binding:physics = </World/PhysicsMaterials/obj_01>
            }
        }
    }

