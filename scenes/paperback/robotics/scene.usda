        point3f[] points = [(-0.06, -0.1, 0), (0.02, -0.12, 0), (0.06, -0.12, 0), (0.12, -0.06, 0), (0.14, 0.02, 0), (0.14, 0.06, 0), (0.12, 0.08, 0), (-0.08, 0.08, 0), (-0.08, -0.08, 0), (-0.06, -0.1, -0.04), (0.02, -0.12, -0.04), (0.06, -0.12, -0.04), (0.12, -0.06, -0.04), (0.14, 0.02, -0.04), (0.14, 0.06, -0.04), (0.12, 0.08, -0.04), (-0.08, 0.08, -0.04), (-0.08, -0.08, -0.04)]
        uniform token subdivisionScheme = "none"
        color3f[] primvars:displayColor = [(0.761, 0.682, 0.647)]
        rel material:binding:physics = </World/PhysicsMaterials/table>
    }

    def Cube "Floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 0, -0.8)
        float3 xformOp:scale = (10, 10, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.2, 0.21, 0.23)]
        rel material:binding:physics = </World/PhysicsMaterials/table>
    }

    def Scope "Objects"
