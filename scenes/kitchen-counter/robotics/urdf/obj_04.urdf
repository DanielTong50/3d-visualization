      </geometry>
    </collision>
    <collision name="obj_04_part3">
      <geometry>
        <mesh filename="../meshes/obj_04_part3.obj" />
      </geometry>
    </collision>
    <collision name="obj_04_part4">
      <geometry>
        <mesh filename="../meshes/obj_04_part4.obj" />
      </geometry>
    </collision>
    <collision name="obj_04_part5">
      <geometry>
        <mesh filename="../meshes/obj_04_part5.obj" />
      </geometry>
    </collision>
    <collision name="obj_04_part6">
      <geometry>
        <mesh filename="../meshes/obj_04_part6.obj" />
      </geometry>
    </collision>
    <contact>
      <lateral_friction value="0.4" />
      <restitution value="0.2" />
    </contact>
  </link>
</robot>
