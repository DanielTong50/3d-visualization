<?xml version="1.0"?>
<robot name="obj_04">
  <!-- scissors: metal, 60 g. Written by Darius 0.2.0. Link frame: +z up, origin at the capture-time bounding-box center; place it at the pose in world.json -->
  <mujoco>
    <compiler meshdir="../meshes/" discardvisual="true" balanceinertia="true" fusestatic="false" />
  </mujoco>
  <link name="obj_04">
    <inertial>
      <origin xyz="-0.00569 -0.02266 0.00013" rpy="0 0 0" />
      <mass value="0.06" />
      <inertia ixx="0.000140986" ixy="1.68772e-06" ixz="-2.65168e-06" iyy="2.45839e-05" iyz="7.13486e-06" izz="0.000158615" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="../meshes/obj_04_visual.obj" />
      </geometry>
      <material name="obj_04_color">
        <color rgba="0.949 0.439 0.094 1" />
      </material>
    </visual>
    <collision name="obj_04_part0">
      <geometry>
        <mesh filename="../meshes/obj_04_part0.obj" />
      </geometry>
    </collision>
    <collision name="obj_04_part1">
