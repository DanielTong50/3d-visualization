<?xml version="1.0"?>
<robot name="obj_02">
  <!-- woven basket: plastic, 677 g. Written by Darius 0.2.0. Link frame: +z up, origin at the capture-time bounding-box center; place it at the pose in world.json -->
  <mujoco>
    <compiler meshdir="../meshes/" discardvisual="true" balanceinertia="true" fusestatic="false" />
  </mujoco>
  <link name="obj_02">
    <inertial>
      <origin xyz="0.00307 -0.00291 0.04793" rpy="0 0 0" />
      <mass value="0.6772" />
      <inertia ixx="0.00456842" ixy="-0.000859895" ixz="0.000132226" iyy="0.0174402" iyz="0.000218402" izz="0.013824" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="../meshes/obj_02_visual.obj" />
      </geometry>
      <material name="obj_02_color">
        <color rgba="0.596 0.537 0.49 1" />
      </material>
    </visual>
    <collision name="obj_02_part0">
      <geometry>
        <mesh filename="../meshes/obj_02_part0.obj" />
      </geometry>
    </collision>
    <collision name="obj_02_part1">
