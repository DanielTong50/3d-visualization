<?xml version="1.0"?>
<robot name="obj_01">
  <!-- toaster oven: metal, 23006 g. Written by Darius 0.2.0. Link frame: +z up, origin at the capture-time bounding-box center; place it at the pose in world.json -->
  <mujoco>
    <compiler meshdir="../meshes/" discardvisual="true" balanceinertia="true" fusestatic="false" />
  </mujoco>
  <link name="obj_01">
    <inertial>
      <origin xyz="-0.02373 -0.00246 -0.0209" rpy="0 0 0" />
      <mass value="23.0059" />
      <inertia ixx="0.383313" ixy="0.147303" ixz="0.0370129" iyy="0.514199" iyz="0.0142374" izz="0.384519" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="../meshes/obj_01_visual.obj" />
      </geometry>
      <material name="obj_01_color">
        <color rgba="0.482 0.424 0.369 1" />
      </material>
    </visual>
    <collision name="obj_01_part0">
      <geometry>
        <mesh filename="../meshes/obj_01_part0.obj" />
      </geometry>
    </collision>
    <collision name="obj_01_part1">
      <geometry>
        <mesh filename="../meshes/obj_01_part1.obj" />
      </geometry>
    </collision>
    <collision name="obj_01_part2">
      <geometry>
        <mesh filename="../meshes/obj_01_part2.obj" />
      </geometry>
    </collision>
    <collision name="obj_01_part3">
      <geometry>
        <mesh filename="../meshes/obj_01_part3.obj" />
      </geometry>
    </collision>
    <collision name="obj_01_part4">
      <geometry>
        <mesh filename="../meshes/obj_01_part4.obj" />
      </geometry>
    </collision>
    <collision name="obj_01_part5">
      <geometry>
        <mesh filename="../meshes/obj_01_part5.obj" />
      </geometry>
    </collision>
    <collision name="obj_01_part6">
      <geometry>
        <mesh filename="../meshes/obj_01_part6.obj" />
      </geometry>
    </collision>
    <collision name="obj_01_part7">
      <geometry>
        <mesh filename="../meshes/obj_01_part7.obj" />
      </geometry>
    </collision>
    <contact>
      <lateral_friction value="0.5" />
      <restitution value="0.1" />
    </contact>
  </link>
</robot>
