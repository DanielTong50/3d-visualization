{
  "$defs": {
    "AppearanceQuality": {
      "additionalProperties": false,
      "description": "How well the splats reproduce the video: PSNR on held-out keyframes the optimizer never saw.",
      "properties": {
        "test_psnr_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Psnr Db"
        },
        "train_psnr_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Train Psnr Db"
        },
        "gaussians": {
          "minimum": 0,
          "title": "Gaussians",
          "type": "integer"
        },
        "train_seconds": {
          "minimum": 0,
          "title": "Train Seconds",
          "type": "number"
        }
      },
      "required": [
        "gaussians",
        "train_seconds"
      ],
      "title": "AppearanceQuality",
      "type": "object"
    },
    "Background": {
      "additionalProperties": false,
      "properties": {
        "visual": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "points": "#/$defs/PointsVisual",
                  "splats": "#/$defs/SplatsVisual"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/PointsVisual"
                },
                {
                  "$ref": "#/$defs/SplatsVisual"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visual"
        },
        "backdrop": {
          "anyOf": [
            {
              "$ref": "#/$defs/SplatsVisual"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Splats beyond the table (walls, floor, surroundings), world coordinates. Only reliable near the filmed viewpoints, so viewers should fade them out as the camera moves away from `capture.cameras`."
        },
        "fallback_visual": {
          "anyOf": [
            {
              "$ref": "#/$defs/PointsVisual"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "collider": {
          "const": "table_plane",
          "default": "table_plane",
          "title": "Collider",
          "type": "string"
        },
        "table_plane": {
          "$ref": "#/$defs/TablePlane"
        },
        "table_color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Color"
        },
        "floor_depth_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Floor this far below the table; null = none",
          "title": "Floor Depth M"
        }
      },
      "required": [
        "table_plane"
      ],
      "title": "Background",
      "type": "object"
    },
    "BoxCollider": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "box",
          "default": "box",
          "title": "Type",
          "type": "string"
        },
        "half_extents": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Half Extents",
          "type": "array"
        }
      },
      "required": [
        "half_extents"
      ],
      "title": "BoxCollider",
      "type": "object"
    },
    "Capture": {
      "additionalProperties": false,
      "description": "The path the phone took while filming, after camera refinement.",
      "properties": {
        "cameras": {
          "items": {
            "$ref": "#/$defs/CaptureCamera"
          },
          "minItems": 1,
          "title": "Cameras",
          "type": "array"
        },
        "fov_deg": {
          "description": "Vertical field of view",
          "exclusiveMaximum": 180,
          "exclusiveMinimum": 0,
          "title": "Fov Deg",
          "type": "number"
        },
        "aspect": {
          "description": "Frame width / height",
          "exclusiveMinimum": 0,
          "title": "Aspect",
          "type": "number"
        },
        "image_size": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Keyframe [width, height] in pixels, for camera intrinsics",
          "title": "Image Size"
        }
      },
      "required": [
        "cameras",
        "fov_deg",
        "aspect"
      ],
      "title": "Capture",
      "type": "object"
    },
    "CaptureCamera": {
      "additionalProperties": false,
      "description": "One keyframe's camera: position, and rotation from the camera's frame (three.js convention:\nlooking down -z with +y up) to the scene frame.",
      "properties": {
        "position": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Position",
          "type": "array"
        },
        "rotation_quat": {
          "description": "x, y, z, w",
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Rotation Quat",
          "type": "array"
        }
      },
      "required": [
        "position",
        "rotation_quat"
      ],
      "title": "CaptureCamera",
      "type": "object"
    },
    "CaptureView": {
      "additionalProperties": false,
      "description": "A camera the scene was filmed from: splats look best from viewpoints like this.",
      "properties": {
        "position": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Position",
          "type": "array"
        },
        "target": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Target",
          "type": "array"
        },
        "fov_deg": {
          "description": "Vertical field of view",
          "exclusiveMaximum": 180,
          "exclusiveMinimum": 0,
          "title": "Fov Deg",
          "type": "number"
        }
      },
      "required": [
        "position",
        "target",
        "fov_deg"
      ],
      "title": "CaptureView",
      "type": "object"
    },
    "ConvexPartsCollider": {
      "additionalProperties": false,
      "description": "A compound of convex pieces (approximate convex decomposition), for concave objects.",
      "properties": {
        "type": {
          "const": "convex_parts",
          "default": "convex_parts",
          "title": "Type",
          "type": "string"
        },
        "files": {
          "description": "Wavefront OBJs in object-local meters, one convex piece each",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Files",
          "type": "array"
        }
      },
      "required": [
        "files"
      ],
      "title": "ConvexPartsCollider",
      "type": "object"
    },
    "CylinderCollider": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cylinder",
          "default": "cylinder",
          "title": "Type",
          "type": "string"
        },
        "radius": {
          "exclusiveMinimum": 0,
          "title": "Radius",
          "type": "number"
        },
        "half_height": {
          "exclusiveMinimum": 0,
          "title": "Half Height",
          "type": "number"
        }
      },
      "required": [
        "radius",
        "half_height"
      ],
      "title": "CylinderCollider",
      "type": "object"
    },
    "Grasp": {
      "additionalProperties": false,
      "description": "A parallel-jaw grasp candidate in the object's body frame (`darius.robotics.grasps`).",
      "properties": {
        "position": {
          "description": "Midpoint between the two fingertip contacts",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Position",
          "type": "array"
        },
        "rotation_quat": {
          "description": "Gripper frame: +z is the approach direction, +y the closing axis",
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Rotation Quat",
          "type": "array"
        },
        "width_m": {
          "description": "Distance between the contacts; the gripper must open wider",
          "exclusiveMinimum": 0,
          "title": "Width M",
          "type": "number"
        },
        "score": {
          "description": "Friction-cone margin, closeness to the center of mass, approach from above",
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "position",
        "rotation_quat",
        "width_m",
        "score"
      ],
      "title": "Grasp",
      "type": "object"
    },
    "HullCollider": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "convex_hull",
          "default": "convex_hull",
          "title": "Type",
          "type": "string"
        },
        "file": {
          "description": "Wavefront OBJ in object-local meters",
          "title": "File",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "title": "HullCollider",
      "type": "object"
    },
    "Inertial": {
      "additionalProperties": false,
      "description": "How an object's mass is distributed, in its body frame (`darius.robotics.mass`).",
      "properties": {
        "com_m": {
          "description": "Center of mass",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Com M",
          "type": "array"
        },
        "inertia_kg_m2": {
          "description": "Inertia tensor about the center of mass, body axes: [ixx, iyy, izz, ixy, ixz, iyz]",
          "items": {
            "type": "number"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Inertia Kg M2",
          "type": "array"
        },
        "model": {
          "description": "solid: uniform density over the collider. shell: the mass sits in a wall that holds `fill_fraction` of the hull's volume (hollow objects)",
          "enum": [
            "solid",
            "shell"
          ],
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "com_m",
        "inertia_kg_m2",
        "model"
      ],
      "title": "Inertial",
      "type": "object"
    },
    "PointsVisual": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "points",
          "default": "points",
          "title": "Type",
          "type": "string"
        },
        "file": {
          "description": "Binary little-endian PLY with float xyz and uchar rgb",
          "title": "File",
          "type": "string"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "point_size_m": {
          "exclusiveMinimum": 0,
          "title": "Point Size M",
          "type": "number"
        }
      },
      "required": [
        "file",
        "count",
        "point_size_m"
      ],
      "title": "PointsVisual",
      "type": "object"
    },
    "Pose": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Position",
          "type": "array"
        },
        "rotation_quat": {
          "default": [
            0.0,
            0.0,
            0.0,
            1.0
          ],
          "description": "x, y, z, w",
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Rotation Quat",
          "type": "array"
        }
      },
      "required": [
        "position"
      ],
      "title": "Pose",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "description": "Where the input video came from",
          "title": "Source",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "frames_used": {
          "title": "Frames Used",
          "type": "integer"
        },
        "models": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Models",
          "type": "object"
        },
        "timings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StageTiming"
          },
          "title": "Timings",
          "type": "array"
        },
        "scale_estimates": {
          "default": [],
          "items": {
            "type": "number"
          },
          "title": "Scale Estimates",
          "type": "array"
        },
        "appearance": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppearanceQuality"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source",
        "frames_used",
        "models"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SceneObject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "material": {
          "title": "Material",
          "type": "string"
        },
        "dimensions_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Dimensions M",
          "type": "array"
        },
        "volume_m3": {
          "minimum": 0,
          "title": "Volume M3",
          "type": "number"
        },
        "hollow": {
          "title": "Hollow",
          "type": "boolean"
        },
        "fill_fraction": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Fill Fraction",
          "type": "number"
        },
        "density_kg_m3": {
          "exclusiveMinimum": 0,
          "title": "Density Kg M3",
          "type": "number"
        },
        "mass_kg": {
          "exclusiveMinimum": 0,
          "title": "Mass Kg",
          "type": "number"
        },
        "friction": {
          "maximum": 2,
          "minimum": 0,
          "title": "Friction",
          "type": "number"
        },
        "restitution": {
          "maximum": 1,
          "minimum": 0,
          "title": "Restitution",
          "type": "number"
        },
        "rigidity": {
          "enum": [
            "rigid",
            "soft"
          ],
          "title": "Rigidity",
          "type": "string"
        },
        "fragile": {
          "title": "Fragile",
          "type": "boolean"
        },
        "visual": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "points": "#/$defs/PointsVisual",
                  "splats": "#/$defs/SplatsVisual"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/PointsVisual"
                },
                {
                  "$ref": "#/$defs/SplatsVisual"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visual"
        },
        "fallback_visual": {
          "anyOf": [
            {
              "$ref": "#/$defs/PointsVisual"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cheaper visual for low-end devices"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hex color used when there is no visual",
          "title": "Color"
        },
        "collider": {
          "discriminator": {
            "mapping": {
              "box": "#/$defs/BoxCollider",
              "convex_hull": "#/$defs/HullCollider",
              "convex_parts": "#/$defs/ConvexPartsCollider",
              "cylinder": "#/$defs/CylinderCollider",
              "sphere": "#/$defs/SphereCollider"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BoxCollider"
            },
            {
              "$ref": "#/$defs/CylinderCollider"
            },
            {
              "$ref": "#/$defs/SphereCollider"
            },
            {
              "$ref": "#/$defs/HullCollider"
            },
            {
              "$ref": "#/$defs/ConvexPartsCollider"
            }
          ],
          "title": "Collider"
        },
        "pick_hull": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Single convex hull OBJ for picking and raycasts",
          "title": "Pick Hull"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "physics_source": {
          "enum": [
            "estimated",
            "measured",
            "hand-authored"
          ],
          "title": "Physics Source",
          "type": "string"
        },
        "physics_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Physics Notes"
        },
        "inertial": {
          "anyOf": [
            {
              "$ref": "#/$defs/Inertial"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Center of mass and inertia tensor"
        },
        "grasps": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Grasp"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parallel-jaw grasp candidates, best first",
          "title": "Grasps"
        }
      },
      "required": [
        "id",
        "label",
        "confidence",
        "material",
        "dimensions_m",
        "volume_m3",
        "hollow",
        "fill_fraction",
        "density_kg_m3",
        "mass_kg",
        "friction",
        "restitution",
        "rigidity",
        "fragile",
        "collider",
        "pose",
        "physics_source"
      ],
      "title": "SceneObject",
      "type": "object"
    },
    "SphereCollider": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "sphere",
          "default": "sphere",
          "title": "Type",
          "type": "string"
        },
        "radius": {
          "exclusiveMinimum": 0,
          "title": "Radius",
          "type": "number"
        }
      },
      "required": [
        "radius"
      ],
      "title": "SphereCollider",
      "type": "object"
    },
    "SplatsVisual": {
      "additionalProperties": false,
      "description": "3D Gaussian splats, stored as Niantic SPZ (v3, gzip) in the scene's own frame (+y up, right-handed).",
      "properties": {
        "type": {
          "const": "splats",
          "default": "splats",
          "title": "Type",
          "type": "string"
        },
        "file": {
          "description": ".spz file",
          "title": "File",
          "type": "string"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "sh_degree": {
          "maximum": 3,
          "minimum": 0,
          "title": "Sh Degree",
          "type": "integer"
        },
        "antialiased": {
          "default": false,
          "description": "Trained with anti-aliased rasterization: render with a 0.3 px\u00b2 blur and opacity compensation. Otherwise the 0.3 px\u00b2 dilation is part of each splat (classic 3DGS) and must be added without compensation.",
          "title": "Antialiased",
          "type": "boolean"
        }
      },
      "required": [
        "file",
        "count",
        "sh_degree"
      ],
      "title": "SplatsVisual",
      "type": "object"
    },
    "StageTiming": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "seconds": {
          "title": "Seconds",
          "type": "number"
        }
      },
      "required": [
        "stage",
        "seconds"
      ],
      "title": "StageTiming",
      "type": "object"
    },
    "TablePlane": {
      "additionalProperties": false,
      "properties": {
        "point": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Point",
          "type": "array"
        },
        "normal": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Normal",
          "type": "array"
        },
        "size_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Size M",
          "type": "array"
        },
        "polygon_m": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "number"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Convex outline of the table top as [x, z] pairs, counter-clockwise seen from +y",
          "title": "Polygon M"
        }
      },
      "required": [
        "point",
        "normal",
        "size_m"
      ],
      "title": "TablePlane",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "scene_id": {
      "title": "Scene Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "units": {
      "const": "meters",
      "default": "meters",
      "title": "Units",
      "type": "string"
    },
    "gravity": {
      "default": [
        0.0,
        -9.81,
        0.0
      ],
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Gravity",
      "type": "array"
    },
    "scale_source": {
      "title": "Scale Source",
      "type": "string"
    },
    "background": {
      "$ref": "#/$defs/Background"
    },
